/* ffaudio player: three bands, top to bottom: the bar, files | queue, now playing | meters */

Screen {
    layout: vertical;
    background: $background;
}

#topbar {
    height: 1;
    background: $boost;
}

#topbar-left {
    width: auto;
}

#topbar-right {
    width: 1fr;
    text-align: right;
    padding-right: 1;
}

#body {
    height: 1fr;
}

#browser-pane {
    width: 32%;
    min-width: 24;
    max-width: 60;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
}

#browser-pane:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

#browser {
    background: transparent;
    scrollbar-size-vertical: 1;
}

#queue-pane {
    width: 1fr;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    border-subtitle-color: $accent;
}

#queue-pane:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

#filter {
    height: 3;
    margin: 0 0 1 0;
}

#queue {
    height: 1fr;
    background: transparent;
    scrollbar-size-vertical: 1;
}

#queue > .datatable--header {
    background: transparent;
    color: $text-muted;
    text-style: bold;
}

#now {
    height: 12;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    padding: 0 1;
}

#art {
    width: 22;
    height: 10;
    margin-right: 2;
}

#info {
    width: 1fr;
    padding: 1 0 0 0;
}

#title {
    height: 1;
    text-style: bold;
}

#subtitle {
    height: 1;
    color: $text;
}

#format {
    height: 2;
    padding-top: 1;
    color: $text-muted;
}

#seek {
    margin-top: 1;
}

#status {
    height: 2;
    padding-top: 1;
}

#meters {
    width: 46;
    margin-left: 2;
}

#levels {
    height: 3;
}

#spectrum {
    height: 1fr;
    margin-top: 1;
}

/* Screens over the main one */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.panel {
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

.panel-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.section {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

.hint {
    color: $text-muted;
}

.row {
    height: 1;
    margin-top: 1;
}

.row-label {
    width: 18;
}

.row-hint {
    color: $text-muted;
    padding: 0 0 0 2;
}

/* One line high, like the compact selects */
.panel Switch {
    border: none;
    height: 1;
    width: 6;
    padding: 0;
}

.panel Switch:focus {
    border: none;
    background: $boost;
}

.row Select {
    width: 44;
}

#effects {
    width: 100%;
    max-width: 128;
    height: 100%;
    max-height: 46;
}

#eq-head {
    height: 1;
    margin-bottom: 1;
}

#eq-head .section {
    width: 20;
    margin-top: 0;
}

#eq-head Select {
    width: 22;
    margin-left: 2;
}

#eq-bands {
    height: 13;
    padding: 0 1;
}

#eq-bands Slider {
    width: 7;
    margin-right: 1;
}

#eq_preamp {
    margin-right: 3;
}

#fx-grid {
    grid-size: 3;
    grid-gutter: 1 2;
    height: 1fr;
}

.box {
    height: auto;
}

.box Slider {
    margin: 1 0 0 0;
}

.box .row-label {
    width: 12;
}

.box .row Select {
    width: 1fr;
}

.box Input {
    margin-top: 1;
}

#filter-string {
    height: 3;
    margin-top: 1;
}

#settings {
    width: 90;
    height: 90%;
}

#settings Slider {
    margin: 1 0 0 0;
    width: 72;
}

.dialog {
    width: 80;
    height: auto;
}

.buttons {
    height: 1;
    margin-top: 1;
}

.buttons Button {
    margin-right: 2;
}

#help {
    width: 90;
    height: 90%;
}

#log {
    width: 110;
    height: 80%;
}

#log-view {
    height: 1fr;
}
