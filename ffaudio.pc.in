prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: ffaudio
Description: Gapless and crossfading music playback library built on FFmpeg and SDL2
URL: https://github.com/Odalith/ffAudio
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lffaudio
Cflags: -I${includedir}/ffaudio
